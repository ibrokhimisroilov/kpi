# =====================================================================
#  Настройки Telegram-бота «Эффективность»
#
#  1. Скопируйте этот файл под именем .env (run.bat сделает это сам).
#  2. Заполните три строки из раздела «ОБЯЗАТЕЛЬНО».
#  3. Остальное менять не нужно. Чтобы изменить настройку, уберите «#»
#     в начале её строки и впишите своё значение.
#
#  Пишите значения без кавычек и без пробелов вокруг «=».
#  Строки, которые начинаются с «#», — комментарии.
# =====================================================================


# ----------------------------- ОБЯЗАТЕЛЬНО ---------------------------

# Токен бота от @BotFather (выглядит так: 1234567890:AAH...xyz).
# Это пароль бота — никому его не показывайте.
BOT_TOKEN=

# Telegram ID начальников (узнать свой ID: напишите @userinfobot).
# Эти люди сразу становятся начальниками после /start.
# Несколько ID — через запятую: 123456789,987654321
ADMIN_IDS=

# Бесплатный ключ Google Gemini: https://aistudio.google.com/apikey
# Если оставить пустым (и не задать запасной AI ниже), бот работает без AI:
# подсказки и оценки по правилам.
GEMINI_API_KEY=


# ----------------------------- ХРАНИЛИЩЕ И ВРЕМЯ ---------------------

# Где хранить базу данных.
# По умолчанию — файл data/bot.db рядом с ботом (свой компьютер или сервер):
# DATABASE_URL=sqlite+aiosqlite:///data/bot.db
#
# В облаке (Render) файлы не сохраняются — нужна внешняя база PostgreSQL, например
# бесплатная Supabase. Берите строку «Session pooler» (порт 5432) из Supabase → Connect
# и вставляйте её как есть, вместе с [YOUR-PASSWORD]: пароль базы впишите отдельно
# в DATABASE_PASSWORD. Адрес сервера не составляйте сами (aws-0 / aws-1 бывает разным).
# Подробно — docs/DEPLOY_RENDER.md.
# DATABASE_URL=postgresql://postgres.abcdefghijklmnop:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Пароль базы PostgreSQL (Supabase). Бот сам подставит его в DATABASE_URL вместо
# [YOUR-PASSWORD] (или если пароля в строке нет). Спецсимволы экранировать не нужно.
# Если пароль уже вписан прямо в DATABASE_URL, эта строка не нужна.
# DATABASE_PASSWORD=

# Часовой пояс: в нём показываются сроки и приходят напоминания.
# Например: Asia/Tashkent, Europe/Moscow, Asia/Almaty.
# TIMEZONE=Asia/Tashkent


# ----------------------------- AI (только бесплатные тарифы) --------

# auto — AI помогает формулировать результат и предлагает оценку
#        (прежнее значение gemini работает так же);
# none — AI выключен полностью, всё по правилам, никуда ничего не уходит.
# AI_PROVIDER=auto

# Порядок AI-провайдеров. Бот спрашивает их по очереди — только тех, у кого
# задан ключ. Закончился бесплатный лимит, Gemini стал платным, сервис не
# отвечает — бот сам переходит к следующему, а если не ответил никто,
# считает по правилам. Делать ничего не нужно.
# AI_PROVIDERS=gemini,groq,cloudflare,mistral,openrouter

# Модели Gemini через запятую. Если у первой исчерпан бесплатный лимит,
# бот сам берёт следующую.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-31b-it
#
# Для подсказки формулировки бот спрашивает эти модели, начиная с самых быстрых
# (3.5-flash-lite, 3.1-flash-lite…), а для оценки результата — с сильных и быстрых
# (3.6-flash, 3.5-flash…). Точный порядок для каждой задачи можно задать сами:
# GEMINI_FORMULATE_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash
# GEMINI_EVALUATE_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.8-flash

# --- Запасной бесплатный AI (необязательно, банковская карта не нужна) ---
# Пригодится, если Google закроет бесплатный тариф Gemini или урежет лимиты.
# Достаточно одного ключа; как получить — docs/DEPLOY_RENDER.md, «Запасной бесплатный AI».
#
# Groq: https://console.groq.com/keys (вход через Google или GitHub). Ключ начинается с gsk_.
# GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
#
# Cloudflare Workers AI: https://dash.cloudflare.com — нужны оба значения.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_MODELS=@cf/google/gemma-4-26b-a4b-it,@cf/mistralai/mistral-small-3.1-24b-instruct,@cf/openai/gpt-oss-120b
#
# Mistral (бесплатный режим): https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=
# MISTRAL_MODELS=mistral-medium-latest,mistral-small-latest
#
# OpenRouter (бесплатные модели «:free», до 50 запросов в сутки): https://openrouter.ai/keys
# Бесплатные модели обслуживают сторонние компании, часть из них обучает модели на запросах; openrouter/free
# выбирает исполнителя сам. Запретите обучение для бесплатных моделей: https://openrouter.ai/settings/privacy
# OPENROUTER_API_KEY=
# OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,openrouter/free
#
# Модели запасных провайдеров, которым можно передавать фото (остальным — только текст).
# AI_VISION_MODELS=qwen/qwen3.8-27b,@cf/google/gemma-4-26b-a4b-it,@cf/mistralai/mistral-small-3.1-24b-instruct,@cf/meta/llama-4-scout-17b-16e-instruct,mistral-medium-latest,mistral-large-latest,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free

# Сколько секунд ждать ответа одной модели. На весь перебор моделей и
# провайдеров бот тратит не больше удвоенного значения, потом — правила.
# AI_TIMEOUT_SEC=60
#
# Подсказка формулировки: одна модель — не дольше 9 с, вся подсказка — не
# дольше 25 с, потом формулировка по правилам. Оценка результата без файлов:
# одна модель — не дольше 30 с (с файлами — AI_TIMEOUT_SEC + 5 с). 0 — без
# отдельного предела.
# AI_FORMULATE_TIMEOUT_SEC=9
# AI_FORMULATE_BUDGET_SEC=25
# AI_EVALUATE_TIMEOUT_SEC=30

# Передавать ли AI содержимое приложенных файлов (PDF, фото, Word, Excel, текст).
# false — AI видит только тексты сотрудника и названия файлов.
# AI_READ_FILES=true

# Файлы больше этого размера (МБ) AI не читает.
# AI_MAX_FILE_MB=10


# ----------------------------- ОЦЕНКА И KPI --------------------------

# Максимальная оценка задачи, %.
# MAX_SCORE=150

# Рекомендуемый штраф за каждый день просрочки, процентных пунктов.
# LATE_PENALTY_PER_DAY=2.0

# Максимальный штраф за просрочку, процентных пунктов.
# LATE_PENALTY_MAX=20.0

# true — просроченная и не сданная задача входит в KPI как 0 %.
# false — не входит, пока результат не сдан и не оценён.
# OVERDUE_COUNTS_AS_ZERO=true


# ----------------------------- СРОКИ И НАПОМИНАНИЯ -------------------

# Время срока, если указана только дата («5 октября» = 5 октября, 18:00).
# DEFAULT_DEADLINE_TIME=18:00

# За сколько дней до срока напоминать сотруднику (через запятую).
# REMINDER_DAYS_BEFORE=3,1

# За сколько часов до срока напомнить в день срока.
# REMINDER_HOURS_BEFORE=3

# С какого часа каждый день напоминать о просроченных задачах.
# OVERDUE_REMINDER_HOUR=10

# «Тихие часы»: с QUIET_HOURS_START до QUIET_HOURS_END бот не пишет.
# QUIET_HOURS_START=21
# QUIET_HOURS_END=8

# Еженедельная сводка начальникам: день недели (0 — понедельник ... 6 — воскресенье) и час.
# DIGEST_WEEKDAY=0
# DIGEST_HOUR=9

# Через сколько дней напомнить начальнику о непроверенном результате.
# REVIEW_REMINDER_DAYS=2

# --- Голосовой ввод (узбекский и русский; распознаёт бесплатный Gemini) ---
# Принимать голосовые сообщения и диктовку; самая длинная запись, секунд.
# VOICE_ENABLED=true
# VOICE_MAX_SEC=120
# Модели Gemini для распознавания речи (через запятую); пусто — порядок по умолчанию.
# GEMINI_TRANSCRIBE_MODELS=
# AI_TRANSCRIBE_TIMEOUT_SEC=25
# AI_TRANSCRIBE_BUDGET_SEC=45

# --- Язык интерфейса: русский и узбекский (каждый выбирает сам: «🌐 Til / Язык», /lang) ---
# Невидимые метки вокруг слов пользователя: по ним перевод отличает название задачи от текста бота.
# Выключать незачем — без них переводятся только строки без слов пользователя.
# I18N_MARKS=true

# --- Автоподтверждение: начальник не ответил вовремя — решение принимается само ---
# Через сколько часов оценка AI подтверждается, а поручение сотрудника принимается (0 — выключено).
# Выходные считаются; срок, попавший в тихие часы, переносится на их конец.
# AUTO_CONFIRM_HOURS=24
# Сама подтверждается только оценка AI не выше этой; оценка выше и расчёт без AI ждут начальника.
# AUTO_CONFIRM_MAX_SCORE=100
# За сколько часов до автоподтверждения напомнить начальнику (0 — не напоминать).
# AUTO_CONFIRM_REMIND_HOURS=3
# Сколько дней начальник может менять автоматически подтверждённую оценку.
# AUTO_REVISE_DAYS=7
# Вес поручения, принятого автоматически, если AI не предложил свой.
# AUTO_PROPOSAL_WEIGHT=10

# Как часто (в минутах) бот проверяет, пора ли что-то напомнить.
# SCHEDULER_INTERVAL_MIN=15


# ----------------------------- РЕЗЕРВНАЯ КОПИЯ -----------------------

# Каждый день бот присылает всем начальникам файл с копией базы данных
# (без звука). Из него можно восстановить все задачи и оценки, даже если
# сервер или компьютер с ботом пропадёт. false — не присылать.
# BACKUP_ENABLED=true

# В котором часу (0–23, по часовому поясу TIMEZONE) присылать копию.
# BACKUP_HOUR=23


# ----------------------------- РЕЖИМ РАБОТЫ (облако) -----------------

# Как бот получает сообщения от Telegram:
#   polling — бот сам забирает сообщения (свой компьютер, run.bat, VPS, docker compose);
#   webhook — Telegram присылает сообщения на веб-адрес бота (Render и другие веб-хостинги).
#             Бот сам «будит» себя каждые 10 минут и каждые 5 минут выполняет задания
#             по времени (напоминания, сводка, резервная копия) — внешний будильник не нужен.
# На своём компьютере оставьте polling. На Render это значение уже задано в render.yaml.
# RUN_MODE=polling

# Публичный адрес бота для webhook, например https://kpi-bot.onrender.com
# На Render не нужен: Render сам сообщает адрес боту (RENDER_EXTERNAL_URL).
# PUBLIC_URL=

# Порт веб-сервера в режиме webhook. На Render не нужен: Render задаёт PORT сам.
# PORT=8080

# Секретные ключи (только латинские буквы и цифры). Можно не задавать: бот сам выведет
# их из BOT_TOKEN, и они не меняются, пока не сменён токен.
#   WEBHOOK_SECRET — защищает адрес, на который Telegram присылает сообщения;
#   TICK_SECRET    — ключ для необязательного внешнего будильника (запасной вариант):
#                    https://<адрес бота>/tick?key=TICK_SECRET. Обычно не нужен.
# WEBHOOK_SECRET=
# TICK_SECRET=

# Если бот уже работает в облаке (Render), запуск на компьютере останавливается с объяснением —
# чтобы случайно не увести бота из облака. 1 — всё-таки перенести бота на этот компьютер
# (облачную копию перед этим остановите: Render → Settings → Suspend Web Service).
# TAKEOVER_WEBHOOK=0


# ----------------------------- ПРИЛОЖЕНИЕ В TELEGRAM (Mini App) ------

# Приложение с графиками, списками задач и формами открывается кнопкой «Открыть» в чате
# с ботом. Работает только в режиме webhook (Render): бот сам ставит кнопку при запуске,
# у @BotFather ничего настраивать не нужно. 0 — выключить приложение (останется только чат).
# WEBAPP_ENABLED=1

# Только для разработчика: проверка приложения в обычном браузере на своём компьютере
# (python -m bot.webapp.dev). В режиме webhook (Render) не действует никогда.
# WEBAPP_DEBUG=0


# ----------------------------- ЖУРНАЛ РАБОТЫ -------------------------

# Подробность сообщений в окне бота: DEBUG, INFO, WARNING, ERROR.
# LOG_LEVEL=INFO
