# =====================================================================
#  Настройки Telegram-бота «Эффективность»
#
#  1. Скопируйте этот файл под именем .env (run.bat сделает это сам).
#  2. Заполните три строки из раздела «ОБЯЗАТЕЛЬНО».
#  3. Остальное менять не нужно. Чтобы изменить настройку, уберите «#»
#     в начале её строки и впишите своё значение.
#
#  Пишите значения без кавычек и без пробелов вокруг «=».
#  Строки, которые начинаются с «#», — комментарии.
# =====================================================================


# ----------------------------- ОБЯЗАТЕЛЬНО ---------------------------

# Токен бота от @BotFather (выглядит так: 1234567890:AAH...xyz).
# Это пароль бота — никому его не показывайте.
BOT_TOKEN=

# Telegram ID руководителей (узнать свой ID: напишите @userinfobot).
# Эти люди сразу становятся руководителями после /start.
# Несколько ID — через запятую: 123456789,987654321
ADMIN_IDS=

# Бесплатный ключ Google Gemini: https://aistudio.google.com/apikey
# Если оставить пустым, бот работает без AI: подсказки и оценки по правилам.
GEMINI_API_KEY=


# ----------------------------- ХРАНИЛИЩЕ И ВРЕМЯ ---------------------

# Где хранить базу данных.
# По умолчанию — файл data/bot.db рядом с ботом (свой компьютер или сервер):
# DATABASE_URL=sqlite+aiosqlite:///data/bot.db
#
# В облаке (Render) файлы не сохраняются — нужна внешняя база PostgreSQL, например
# бесплатная Supabase. Берите строку «Session pooler» (порт 5432) из Supabase → Connect
# и вставляйте её как есть, вместе с [YOUR-PASSWORD]: пароль базы впишите отдельно
# в DATABASE_PASSWORD. Адрес сервера не составляйте сами (aws-0 / aws-1 бывает разным).
# Подробно — docs/DEPLOY_RENDER.md.
# DATABASE_URL=postgresql://postgres.abcdefghijklmnop:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Пароль базы PostgreSQL (Supabase). Бот сам подставит его в DATABASE_URL вместо
# [YOUR-PASSWORD] (или если пароля в строке нет). Спецсимволы экранировать не нужно.
# Если пароль уже вписан прямо в DATABASE_URL, эта строка не нужна.
# DATABASE_PASSWORD=

# Часовой пояс: в нём показываются сроки и приходят напоминания.
# Например: Asia/Tashkent, Europe/Moscow, Asia/Almaty.
# TIMEZONE=Asia/Tashkent


# ----------------------------- AI (бесплатный Gemini) ----------------

# gemini — AI помогает формулировать результат и предлагает оценку;
# none   — AI выключен полностью, всё по правилам, в Google ничего не уходит.
# AI_PROVIDER=gemini

# Модели Gemini через запятую. Если у первой исчерпан бесплатный лимит,
# бот сам берёт следующую; если у всех — считает по правилам.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# Сколько секунд ждать ответа AI.
# AI_TIMEOUT_SEC=60

# Передавать ли AI содержимое приложенных файлов (PDF, фото, Word, Excel, текст).
# false — AI видит только тексты сотрудника и названия файлов.
# AI_READ_FILES=true

# Файлы больше этого размера (МБ) AI не читает.
# AI_MAX_FILE_MB=10


# ----------------------------- ОЦЕНКА И KPI --------------------------

# Максимальная оценка задачи, %.
# MAX_SCORE=150

# Рекомендуемый штраф за каждый день просрочки, процентных пунктов.
# LATE_PENALTY_PER_DAY=2.0

# Максимальный штраф за просрочку, процентных пунктов.
# LATE_PENALTY_MAX=20.0

# true — просроченная и не сданная задача входит в KPI как 0 %.
# false — не входит, пока результат не сдан и не оценён.
# OVERDUE_COUNTS_AS_ZERO=true


# ----------------------------- СРОКИ И НАПОМИНАНИЯ -------------------

# Время срока, если указана только дата («5 октября» = 5 октября, 18:00).
# DEFAULT_DEADLINE_TIME=18:00

# За сколько дней до срока напоминать сотруднику (через запятую).
# REMINDER_DAYS_BEFORE=3,1

# За сколько часов до срока напомнить в день срока.
# REMINDER_HOURS_BEFORE=3

# С какого часа каждый день напоминать о просроченных задачах.
# OVERDUE_REMINDER_HOUR=10

# «Тихие часы»: с QUIET_HOURS_START до QUIET_HOURS_END бот не пишет.
# QUIET_HOURS_START=21
# QUIET_HOURS_END=8

# Еженедельная сводка руководителям: день недели (0 — понедельник ... 6 — воскресенье) и час.
# DIGEST_WEEKDAY=0
# DIGEST_HOUR=9

# Через сколько дней напомнить руководителю о непроверенном результате.
# REVIEW_REMINDER_DAYS=2

# Как часто (в минутах) бот проверяет, пора ли что-то напомнить.
# SCHEDULER_INTERVAL_MIN=15


# ----------------------------- РЕЗЕРВНАЯ КОПИЯ -----------------------

# Каждый день бот присылает всем руководителям файл с копией базы данных
# (без звука). Из него можно восстановить все задачи и оценки, даже если
# сервер или компьютер с ботом пропадёт. false — не присылать.
# BACKUP_ENABLED=true

# В котором часу (0–23, по часовому поясу TIMEZONE) присылать копию.
# BACKUP_HOUR=23


# ----------------------------- РЕЖИМ РАБОТЫ (облако) -----------------

# Как бот получает сообщения от Telegram:
#   polling — бот сам забирает сообщения (свой компьютер, run.bat, VPS, docker compose);
#   webhook — Telegram присылает сообщения на веб-адрес бота (Render и другие веб-хостинги).
#             Бот сам «будит» себя каждые 10 минут и каждые 5 минут выполняет задания
#             по времени (напоминания, сводка, резервная копия) — внешний будильник не нужен.
# На своём компьютере оставьте polling. На Render это значение уже задано в render.yaml.
# RUN_MODE=polling

# Публичный адрес бота для webhook, например https://kpi-bot.onrender.com
# На Render не нужен: Render сам сообщает адрес боту (RENDER_EXTERNAL_URL).
# PUBLIC_URL=

# Порт веб-сервера в режиме webhook. На Render не нужен: Render задаёт PORT сам.
# PORT=8080

# Секретные ключи (только латинские буквы и цифры). Можно не задавать: бот сам выведет
# их из BOT_TOKEN, и они не меняются, пока не сменён токен.
#   WEBHOOK_SECRET — защищает адрес, на который Telegram присылает сообщения;
#   TICK_SECRET    — ключ для необязательного внешнего будильника (запасной вариант):
#                    https://<адрес бота>/tick?key=TICK_SECRET. Обычно не нужен.
# WEBHOOK_SECRET=
# TICK_SECRET=

# Если бот уже работает в облаке (Render), запуск на компьютере останавливается с объяснением —
# чтобы случайно не увести бота из облака. 1 — всё-таки перенести бота на этот компьютер
# (облачную копию перед этим остановите: Render → Settings → Suspend Web Service).
# TAKEOVER_WEBHOOK=0


# ----------------------------- ЖУРНАЛ РАБОТЫ -------------------------

# Подробность сообщений в окне бота: DEBUG, INFO, WARNING, ERROR.
# LOG_LEVEL=INFO
